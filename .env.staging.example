DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=false
SECRET_KEY=replace_with_a_random_staging_secret_at_least_50_chars
DATABASE_URL=postgresql://staging_user:replace_me@postgres:5432/docnear_staging
ALLOWED_HOSTS=api.staging.docnear.example
CORS_ALLOWED_ORIGINS=https://staging.docnear.example,https://doctor.staging.docnear.example,https://admin.staging.docnear.example,https://owner.staging.docnear.example
CSRF_TRUSTED_ORIGINS=https://api.staging.docnear.example,https://staging.docnear.example,https://doctor.staging.docnear.example,https://admin.staging.docnear.example,https://owner.staging.docnear.example
REDIS_URL=redis://redis:6379/0

OTP_SMS_PROVIDER=http
SMS_API_URL=https://sms-staging.example.test/send
SMS_API_KEY=replace_with_staging_provider_key
SMS_SENDER_NAME=DocNear-Staging

TELEGRAM_OTP_ENABLED=true
TELEGRAM_BOT_TOKEN=replace_with_staging_bot_token
TELEGRAM_BOT_USERNAME=docnear_staging_bot
TELEGRAM_BOT_WEBHOOK_SECRET=replace_with_staging_webhook_secret
DOCNEAR_API_BASE_URL=https://api.staging.docnear.example/api/v1
GOOGLE_MAPS_API_KEY=replace_with_restricted_staging_maps_key
TRUSTED_PROXY_COUNT=1
TRUST_PROXY=true
LEGACY_PASSWORD_AUTH_ENABLED=false

# Frontend build-time values; these are URLs, not credentials.
VITE_API_BASE_URL=https://api.staging.docnear.example/api/v1
VITE_TELEGRAM_BOT_USERNAME=docnear_staging_bot
