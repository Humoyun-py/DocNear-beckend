# Template only. Keep real values outside the repository and point Django to
# them with DOCNEAR_ENV_FILE, for example ~/docnear-env-backup/repo-root.env.
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=true
DATABASE_URL=postgresql://docnear:change_me@127.0.0.1:5432/docnear
SECRET_KEY=replace_with_a_long_random_value
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,http://localhost:3003,http://127.0.0.1:3003,http://localhost:3004,http://127.0.0.1:3004

# Phone-only OTP authentication
JWT_ACCESS_MINUTES=5
JWT_REFRESH_DAYS=7
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_PHONE_REQUEST_LIMIT=3
OTP_IP_REQUEST_LIMIT=20
OTP_REQUEST_RATE=5/min
OTP_VERIFY_RATE=10/min
OTP_SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_NAME=DocNear
LEGACY_PASSWORD_AUTH_ENABLED=false

# Telegram OTP and bot. Keep populated values only in .runtime/local.env.
TELEGRAM_OTP_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_WEBHOOK_SECRET=
DOCNEAR_API_BASE_URL=http://127.0.0.1:8001/api/v1

# Optional queues/cache
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Production email provider
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=DocNear <noreply@docnear.uz>

# Optional S3-compatible production media storage
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=

# Set true only behind a trusted proxy that overwrites X-Forwarded-Proto.
TRUST_PROXY=false
