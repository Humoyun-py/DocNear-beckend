DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=false
SECRET_KEY=change_me_with_a_cryptographically_random_secret_at_least_50_chars
DATABASE_URL=postgresql://user:password@postgres:5432/docnear
POSTGRES_DB=docnear
POSTGRES_USER=docnear_user
POSTGRES_PASSWORD=change_me_with_a_random_database_password
ALLOWED_HOSTS=api.docnear.uz
CORS_ALLOWED_ORIGINS=https://docnear.uz,https://doctor.docnear.uz,https://admin.docnear.uz,https://owner.docnear.uz
CSRF_TRUSTED_ORIGINS=https://api.docnear.uz,https://docnear.uz,https://doctor.docnear.uz,https://admin.docnear.uz,https://owner.docnear.uz

SMS_OTP_ENABLED=false
OTP_SMS_PROVIDER=http
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_NAME=DocNear

TELEGRAM_OTP_ENABLED=true
TELEGRAM_BOT_TOKEN=change_me
TELEGRAM_BOT_USERNAME=change_me
TELEGRAM_BOT_WEBHOOK_SECRET=change_me
REDIS_URL=redis://redis:6379/0
GOOGLE_MAPS_API_KEY=change_me_restricted_key
DOCNEAR_API_BASE_URL=https://api.docnear.uz/api/v1
TRUSTED_PROXY_COUNT=1
TRUST_PROXY=true
LEGACY_PASSWORD_AUTH_ENABLED=false
